<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Document</title>
  </head>

  <body>
    <div class="container">
      <%- include('./partials/header') %> <% if(user) { %>
      <h2>You are logged In</h2>
      <% } else { %>
      <h2>You are not logged in</h2>
      <% } %>
      <h1>URL Shortener</h1>

      <form action="/edit/<%=userId %>/<%=id %>" method="post">
        <div>
          <label for="url">Enter URL:</label>
          <input type="url" name="url" id="url" required value="<%= url  %>" />
        </div>
        <div>
          <label for="shortCode">ShortCode:</label>
          <input type="text" name="shortCode" id="shortCode" value="<%= shortCode %>" required />
        </div>
        <button type="submit">Update</button>
      </form>
      <% if(errors && errors.length>0){ %> <% errors.forEach((error) => {%>
      <p class="flash-error"><%= error %></p>
      <% })}%>
    </div>

    <script>
      // Copy button functionality
      document.addEventListener("DOMContentLoaded", function () {
        const copyButtons = document.querySelectorAll(".copy-btn");

        copyButtons.forEach((button) => {
          button.addEventListener("click", function () {
            const textToCopy = this.dataset.clipboard;
            navigator.clipboard
              .writeText(textToCopy)
              .then(() => {
                // Visual feedback - add copied class temporarily
                this.classList.add("copied");

                // Remove the class after 2 seconds
                setTimeout(() => {
                  this.classList.remove("copied");
                }, 2000);
              })
              .catch((err) => {
                console.error("Could not copy text: ", err);
              });
          });
        });
      });
    </script>
  </body>
</html>
